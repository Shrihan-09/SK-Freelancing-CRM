generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatar       String?
  role         String   @default("member") // owner, admin, member
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  tasks            Task[]            @relation("AssignedTasks")
  createdTasks     Task[]            @relation("CreatedTasks")
  messages         Message[]
  comments         Comment[]
  activities       Activity[]
  aiHistory        AIHistory[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  businesses  Business[]
  tasks       Task[]
  messages    Message[]
  activities  Activity[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Business {
  id            String   @id @default(cuid())
  workspaceId   String?
  companyName   String
  industry      String
  location      String
  city          String?
  state         String?  @default("NJ")
  phone         String?
  email         String?
  website       String?
  hasWebsite    Boolean  @default(false)
  googleRating  Float?
  reviewCount   Int?     @default(0)
  familyOwned   Boolean  @default(false)
  yearsInBiz    String?
  websiteScore  Int?     @default(0)
  leadScore     Int?     @default(0)
  status        String   @default("New Lead")
  priority      String   @default("Medium")
  notes         String?
  tags          String?
  contractValue Float?
  lastContact   DateTime?
  nextFollowUp  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace?  @relation(fields: [workspaceId], references: [id])
  analysis      AIAnalysis?
  callLogs      CallLog[]
  tasks         Task[]
  comments      Comment[]
  activities    Activity[]

  @@index([industry])
  @@index([location])
  @@index([status])
  @@index([leadScore])
  @@index([createdAt])
}

model AIAnalysis {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  problemsFound         String?
  websiteOpportunities  String?
  automationOpps        String?
  coldCallScript        String?
  recommendedFeatures   String?
  pitchSummary          String?
  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Task {
  id           String   @id @default(cuid())
  workspaceId  String?
  businessId   String?
  assigneeId   String?
  createdById  String?
  title        String
  description  String?
  status       String   @default("Backlog")
  priority     String   @default("Medium")
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  business     Business?  @relation(fields: [businessId], references: [id])
  assignee     User?      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy    User?      @relation("CreatedTasks", fields: [createdById], references: [id])
  comments     Comment[]

  @@index([workspaceId])
  @@index([status])
  @@index([assigneeId])
}

model Message {
  id          String   @id @default(cuid())
  workspaceId String?
  senderId    String?
  channel     String   @default("general")
  content     String
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  sender      User?      @relation(fields: [senderId], references: [id])
}

model Comment {
  id         String   @id @default(cuid())
  taskId     String?
  businessId String?
  authorId   String?
  content    String
  createdAt  DateTime @default(now())

  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author     User?     @relation(fields: [authorId], references: [id])
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  businessId  String?
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
  business    Business?  @relation(fields: [businessId], references: [id])
}

model AIHistory {
  id        String   @id @default(cuid())
  userId    String?
  prompt    String
  response  String
  type      String   @default("general")
  createdAt DateTime @default(now())

  user      User? @relation(fields: [userId], references: [id])
}

model CallLog {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outcome     String
  notes       String?
  duration    Int?
  calledAt    DateTime @default(now())
}

model Location {
  id            String  @id @default(cuid())
  city          String
  state         String  @default("NJ")
  county        String?
  businessCount Int     @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())

  @@unique([city, state])
}

model Industry {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  color       String  @default("#ef4444")
  icon        String  @default("briefcase")
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
