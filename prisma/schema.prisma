generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  password           String
  avatar             String?
  phone              String?
  emailNotifications Boolean   @default(true)
  smsNotifications   Boolean   @default(false)
  role               String    @default("member")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  importedBusinesses Business[] @relation("ImportedBy")
  tasks              Task[]     @relation("AssignedTasks")
  createdTasks       Task[]     @relation("CreatedTasks")
  messages           Message[]
  activities         Activity[]
}

model Business {
  id            String    @id @default(cuid())
  importedById  String?
  companyName   String
  industry      String
  location      String
  city          String?
  state         String?   @default("NJ")
  phone         String?
  email         String?
  website       String?
  hasWebsite    Boolean   @default(false)
  googleRating  Float?
  reviewCount   Int?      @default(0)
  familyOwned   Boolean   @default(false)
  yearsInBiz    String?
  websiteScore  Int?      @default(0)
  leadScore     Int?      @default(0)
  status        String    @default("New Lead")
  priority      String    @default("Medium")
  notes         String?
  tags          String?
  contractValue Float?
  lastContact   DateTime?
  nextFollowUp  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  importedBy    User?     @relation("ImportedBy", fields: [importedById], references: [id])
  tasks         Task[]
  activities    Activity[]
  callLogs      CallLog[]

  @@index([industry])
  @@index([status])
  @@index([leadScore])
  @@index([createdAt])
}

model Task {
  id           String    @id @default(cuid())
  businessId   String?
  assigneeId   String?
  createdById  String?
  title        String
  description  String?
  status       String    @default("Backlog")
  priority     String    @default("Medium")
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business? @relation(fields: [businessId], references: [id])
  assignee     User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy    User?     @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([status])
  @@index([assigneeId])
}

model Message {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   @default("general")
  content   String
  createdAt DateTime @default(now())

  sender    User?    @relation(fields: [userId], references: [id])

  @@index([channel])
  @@index([createdAt])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String?
  businessId  String?
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  user        User?     @relation(fields: [userId], references: [id])
  business    Business? @relation(fields: [businessId], references: [id])
}

model CallLog {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outcome     String
  notes       String?
  duration    Int?
  calledAt    DateTime @default(now())
}

model Location {
  id        String   @id @default(cuid())
  city      String
  state     String   @default("NJ")
  county    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([city, state])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
